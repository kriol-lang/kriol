fn ola(textu nomi, bool na_kriolu) {
  si na_kriolu {
    mostraln(f"👋 Olá {nomi}, ami nta programa na Kriol!");
  } sinau {
    mostraln(f"👋 Hello {nomi}, I program in Kriol!");
  }
}

fn inisiu() {
  // toma valor di entrada
  textu nomi = toma('Nomi: ');

  // executa funson `ola`
  ola(nomi, sin);
  ola(nomi, nau);
}