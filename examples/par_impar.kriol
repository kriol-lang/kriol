fn num_par(int n) bool {
  divolvi (n % 2) == 0;
}

fn inisiu() : Erru {
  textu entrada = tenta toma("Screbi númeru interu: ");
  int numeru = tenta int::konverti(entrada);

  si num_par(numeru) {
    mostraln(f'Númeru {numeru} é PAR.');
  } sinon {
    mostraln(f'Númeru {numeru} é IMPAR.');
  }
}
