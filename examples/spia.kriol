fn divide(int a, int b) int {
    divolvi a / b;
}

fn inisiu() {
    textu entrada = toma('Screbi un númeru interu: ');
    spia {
        int numeru = int::konverti(entrada);
        mostraln(f"100 / {numeru} = {divide(100, numeru)}");
    } oops (err) {
        mostraln(f"Erru ({err.tipu}): {err.mensagem}");
    } sempri {
        mostraln("Fin.");
    }
}
