fn soma(int n) int {
    int acc = 0;

    pa int i = 1 ; i <= n ; i += 1 {
        acc = acc + i;
    }

    divolvi acc;
}

fn inisiu() {
    textu entrada = toma('Screbi um númeru interu: ');
    int numeru = int::konverti(entrada);
    mostran(f"Soma di 1 ti {numeru} é igual a {soma(numeru)}.");
}
