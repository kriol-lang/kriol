fn fibo(int n) int {
    konfirma(n >= 0);

    si n <= 1 {
        divolvi 1;
    } sinon {
        divolvi fibo(n - 1) + fibo(n - 2);
    }
}

fn inisiu() {
    int[10] seq = [0; 10];

    pa int i = 0; i < 10; i += 1 {
        seq[i] = fibo(i);
    }

    mostran(f"A sequência de Fibonacci até o 10º elemento é {seq}");
}
