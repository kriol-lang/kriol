// expect: :11: erro de execução: divisão por zero
fn zero() int {
    divolvi 0;
}

fn oops_ku_sempri() int : Erru {
    spia {
        lansa Erru{mensagem = "x"};
    } oops (err) {
        mostraln(f"oops apanhou {err.tipu}");
        divolvi 1 / zero();
    } sempri {
        mostraln("sempri");
    }
}

fn inisiu() {
    mostraln(oops_ku_sempri() sinon 42);
    mostraln("nunca");
}
