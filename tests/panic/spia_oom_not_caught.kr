// expect: erro de execução: a memória do programa esgotou-se
// env: GC_MAXIMUM_HEAP_SIZE=33554432
fn inisiu() {
    spia {
        textu t = "0123456789abcdef";
        pa int i = 0; i < 40; i += 1 {
            t = f"{t}{t}";
        }
        mostraln("nunca");
    } oops (err) {
        mostraln("oops");
    } sempri {
        mostraln("sempri");
    }
}
