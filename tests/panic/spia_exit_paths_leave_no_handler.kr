// expect: :64: erro de execução: divisão por zero
fn do_corpo() int {
    spia {
        divolvi 1;
    } sempri {
        mostraln("sempri");
    }
}

fn do_oops() int {
    spia {
        lansa Erru{mensagem = "x"};
    } oops (err) {
        divolvi 2;
    } sempri {
        mostraln("sempri");
    }
    divolvi 0;
}

fn dos_ciclos() {
    pa int i = 0; i < 3; i += 1 {
        spia {
            si i == 0 {
                kontinua;
            }
            kebra;
        } oops (err) {
            mostraln(err.mensagem);
        }
    }
}

fn kebra_do_oops_com_sempri() {
    pa int i = 0; i < 2; i += 1 {
        spia {
            lansa Erru{mensagem = "x"};
        } oops (err) {
            kebra;
        } sempri {
            mostraln("sempri do kebra");
        }
    }
}

fn kontinua_do_oops_com_sempri() {
    pa int i = 0; i < 2; i += 1 {
        spia {
            lansa Erru{mensagem = "x"};
        } oops (err) {
            kontinua;
        } sempri {
            mostraln("sempri do kontinua");
        }
    }
}

fn inisiu() {
    int zero = do_corpo() + do_oops() - 3;
    dos_ciclos();
    kebra_do_oops_com_sempri();
    kontinua_do_oops_com_sempri();
    mostraln(zero);
    mostraln(10 / zero);
}
