// expect: erro não tratado: falha
// In a function that can fail, an unhandled call in an oops inside a sempri is not returned to the caller.
fn falha() int : Erru {
    lansa Erru{mensagem = "falha"};
}

fn limpa() int : Erru {
    spia {
        mostraln("korpu");
    } sempri {
        spia {
            lansa Erru{mensagem = "primeiru"};
        } oops (e) {
            int v = falha();
        }
    }
    divolvi 1;
}

fn inisiu() {
    spia {
        int r = limpa();
        mostraln(f"nunca {r}");
    } oops (e) {
        mostraln("nunca");
    }
}
