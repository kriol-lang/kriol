// expect: divisão por zero
// An error a sempri does not catch stops the program; the enclosing oops never sees it.
fn inisiu() {
    int zero = 0;
    spia {
        spia {
            mostraln("korpu");
        } sempri {
            mostraln("antis");
            int x = 1 / zero;
            mostraln("dipos");
        }
    } oops (e) {
        mostraln("nunca");
    }
}
