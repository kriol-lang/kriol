// expect: :4: erro de execução: o índice 4 está fora do array, que vai de 0 a 3
fn soma_ate(int[4] v, int n) int {
    int total = 0;
    pa int i = 0; i <= n; i += 1 { total += v[i]; }
    divolvi total;
}

fn inisiu() {
    mostran(soma_ate([1, 2, 3, 4], 3));
    mostran(soma_ate([1, 2, 3, 4], 4));
}
