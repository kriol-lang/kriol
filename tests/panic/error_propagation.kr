// expect: :13: erro não tratado: divizon pa zero
fn metadi(int a, int b) num : Erru {
    si b == 0 { lansa Erru{mensagem = "divizon pa zero"}; }
    divolvi (num) a / b;
}

fn media(int a, int b) num : Erru {
    divolvi spia metadi(a + b, 2) + spia metadi(a, b);
}

fn inisiu() : Erru {
    mostraln(spia media(4, 2));
    mostraln(spia media(4, 0));
    mostraln("never");
}
