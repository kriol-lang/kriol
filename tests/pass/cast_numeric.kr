fn inisiu() {
    // Real to integer truncates toward zero.
    konfirma((int) 3.9 == 3);
    konfirma((int) -3.9 == -3);
    konfirma((int) -2.5 == -2);

    // Integer to integer wraps to the target width.
    konfirma((u8) 300 == 44);
    konfirma((i8) 200 == -56);
    konfirma((u32) -1 == 4294967295);

    // Integer to real, and between real widths.
    konfirma((num) 7 / 2 == 3.5);
    f32 pequenu = (f32) 1.5;
    konfirma(pequenu == 1.5);

    // bool converts to and from numbers.
    konfirma((int) sin == 1);
    konfirma((bool) 5);
    konfirma(!(bool) 0);
    konfirma((bool) 0.5);

    // A cast is a unary operator: it binds tighter than binary operators.
    konfirma((int) 3.9 + 1 == 4);
    konfirma((int) (3.9 + 1.0) == 4);

    // Out-of-range and NaN real values saturate instead of being undefined.
    num enorme = 1000000.0 * 1000000.0 * 1000000.0 * 1000000.0;
    konfirma((int) enorme == 9223372036854775807);
    konfirma((int) -enorme == -9223372036854775807 - 1);
    num nada = 0.0 / 0.0;
    konfirma((int) nada == 0);
    konfirma((u8) 1000.5 == 255);

    // Explicit casts allow what implicit conversions reject.
    int grandi = 70000;
    i16 curtu = (i16) grandi;
    konfirma(curtu == 4464);
}
