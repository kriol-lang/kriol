fn falha(textu mensagem) int : Erru {
    lansa Erru{mensagem = mensagem};
}

fn lansa_direto() {
    spia {
        mostraln("antes do lansa");
        lansa Erru{mensagem = "direto"};
        mostraln("nunca");
    } oops (err) {
        mostraln(err.mensagem);
        konfirma(err.linha == 8);
    }
}

fn propaga_no_spia() int : Erru {
    spia {
        int x = spia falha("propagadu");
        mostraln(x);
    } oops (err) {
        mostraln(f"oops do spia: {err.mensagem}");
    }
    divolvi 7;
}

fn chamada_sem_spia() {
    spia {
        int x = falha("sem spia");
        mostraln(x);
    } oops (err) {
        mostraln(f"oops sem spia: {err.mensagem}");
    }
}

fn relansa() int : Erru {
    spia {
        lansa Erru{mensagem = "relansado"};
    } oops (err) {
        lansa err;
    }
    divolvi 1;
}

fn aninhado() {
    spia {
        spia {
            lansa Erru{mensagem = "interior"};
        } oops (err) {
            mostraln(f"interior apanhou {err.mensagem}");
            lansa Erru{mensagem = "do oops interior"};
        }
        mostraln("nunca");
    } oops (err) {
        mostraln(f"exterior apanhou {err.mensagem}");
    }
}

fn com_sempri(bool falhar) {
    spia {
        si falhar {
            lansa Erru{mensagem = "falhou"};
        }
        mostraln("corpo terminou");
    } oops (err) {
        mostraln(f"oops: {err.mensagem}");
    } sempri {
        mostraln("sempri");
    }
}

fn ciclo_no_sempri() {
    spia {
        mostraln("corpo");
    } sempri {
        pa int i = 0; i < 5; i += 1 {
            si i == 2 {
                kebra;
            }
            mostraln(i);
        }
    }
}

fn konverti_sem_tratamento() {
    spia {
        int n = int::konverti("abc");
        mostraln(n);
    } oops (err) {
        mostraln(f"oops do konverti: {err.tipu}");
    }
}

fn inisiu() : Erru {
    lansa_direto();
    mostraln(spia propaga_no_spia());
    chamada_sem_spia();
    spia {
        mostraln(relansa());
    } oops (err) {
        mostraln(f"relansa falhou: {err.mensagem}");
    }
    aninhado();
    com_sempri(nau);
    com_sempri(sin);
    ciclo_no_sempri();
    konverti_sem_tratamento();
}
