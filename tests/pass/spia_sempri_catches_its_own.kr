// A sempri may fail inside a spia of its own that catches the error; the error never leaves it.
fn falha() int : Erru {
    lansa Erru{mensagem = "falha"};
}

fn protejidu(int zero) {
    spia {
        int x = 1 / zero;
    } oops (e) {
        mostraln(f"protejidu: {e.tipu}");
    }
}

// The outer spia stays active while the sempri runs: handlers pushed inside the sempri still catch.
fn inisiu() {
    spia {
        int zero = 0;
        spia {
            mostraln("korpu");
        } sempri {
            spia {
                lansa Erru{mensagem = "lansa"};
            } oops (e) {
                mostraln(f"sempri: {e.mensagem}");
            }
            spia {
                int v = spia falha();
            } oops (e) {
                mostraln(f"sempri: {e.mensagem}");
            }
            spia {
                spia {
                    int x = 1 / zero;
                } sempri {
                    mostraln("sempri dentu");
                }
            } oops (e) {
                mostraln(f"sempri: {e.tipu}");
            }
            protejidu(zero);
            mostraln("fin");
        }
    } oops (e) {
        mostraln("nunca");
    }
}
