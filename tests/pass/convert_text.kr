fn valor(textu t) int : Erru {
    divolvi tenta int::konverti(t);
}

fn inisiu() : Erru {
    // Integers: sign, surrounding white space, exact range of each width.
    konfirma((int::konverti("42") sinau -1) == 42);
    konfirma((int::konverti("  -17 ") sinau 0) == -17);
    konfirma((int::konverti("+5") sinau 0) == 5);
    konfirma((int::konverti("9223372036854775807") sinau 0) == 9223372036854775807);
    konfirma((u8::konverti("255") sinau 0) == 255);
    konfirma((i8::konverti("-128") sinau 0) == -128);
    konfirma((u64::konverti("18446744073709551615") sinau 0) == (u64) -1);

    // Invalid or out-of-range text takes the fallback.
    konfirma((int::konverti("abc") sinau -1) == -1);
    konfirma((int::konverti("") sinau -1) == -1);
    konfirma((int::konverti("12x") sinau -1) == -1);
    konfirma((int::konverti("9223372036854775808") sinau -1) == -1);
    konfirma((u8::konverti("256") sinau 7) == 7);
    konfirma((u8::konverti("-1") sinau 7) == 7);
    konfirma((i8::konverti("128") sinau 7) == 7);

    // Reals and booleans.
    konfirma((num::konverti("3.25") sinau -1.0) == 3.25);
    konfirma((num::konverti(" -2e3 ") sinau 0.0) == -2000.0);
    konfirma((num::konverti("1.") sinau -1.0) == -1.0);
    konfirma((num::konverti("nan") sinau -1.0) == -1.0);
    konfirma((f32::konverti("0.5") sinau -1.0) == 0.5);
    konfirma((f32::konverti("1e300") sinau -1.0) == -1.0);
    konfirma(bool::konverti("sin") sinau nau);
    konfirma(!(bool::konverti("nau") sinau sin));
    konfirma(bool::konverti("true") sinau sin);

    // tenta propagates the error of an invalid conversion.
    konfirma((valor("12") sinau 0) == 12);
    konfirma((valor("doze") sinau 0) == 0);
}
