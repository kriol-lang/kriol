fn zero() int {
    divolvi 0;
}

fn so_sempri() int : Erru {
    spia {
        divolvi 1 / zero();
    } sempri {
        mostraln("sempri do corpo");
    }
}

fn oops_ku_sempri() int : Erru {
    spia {
        divolvi 2 / zero();
    } oops (err) {
        mostraln(f"oops apanhou {err.tipu}");
        divolvi 3 / zero();
    } sempri {
        mostraln("sempri do oops");
    }
}

fn spia_dentu_spia() int : Erru {
    spia {
        spia {
            divolvi 4 / zero();
        } sempri {
            mostraln("sempri interior");
        }
    } sempri {
        mostraln("sempri exterior");
    }
}

fn lansa_ku_sempri() int : Erru {
    spia {
        lansa Erru{mensagem = "lansadu"};
    } sempri {
        mostraln("sempri do lansa");
    }
}

fn chama_so_sempri() {
    spia {
        mostraln(so_sempri() sinau 42);
    } oops (err) {
        mostraln(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn chama_oops_ku_sempri() {
    spia {
        mostraln(oops_ku_sempri() sinau 42);
    } oops (err) {
        mostraln(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn chama_spia_dentu_spia() {
    spia {
        mostraln(spia_dentu_spia() sinau 42);
    } oops (err) {
        mostraln(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn inisiu() {
    chama_so_sempri();
    chama_oops_ku_sempri();
    chama_spia_dentu_spia();
    mostraln(lansa_ku_sempri() sinau 42);
}
