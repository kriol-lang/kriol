fn zero() int {
    divolvi 0;
}

fn so_sempri() int : Erru {
    spia {
        divolvi 1 / zero();
    } sempri {
        mostran("sempri do corpo");
    }
}

fn oops_ku_sempri() int : Erru {
    spia {
        divolvi 2 / zero();
    } oops (err) {
        mostran(f"oops apanhou {err.tipu}");
        divolvi 3 / zero();
    } sempri {
        mostran("sempri do oops");
    }
}

fn spia_dentu_spia() int : Erru {
    spia {
        spia {
            divolvi 4 / zero();
        } sempri {
            mostran("sempri interior");
        }
    } sempri {
        mostran("sempri exterior");
    }
}

fn lansa_ku_sempri() int : Erru {
    spia {
        lansa Erru{mensage = "lansadu"};
    } sempri {
        mostran("sempri do lansa");
    }
}

fn chama_so_sempri() {
    spia {
        mostran(so_sempri() sinon 42);
    } oops (err) {
        mostran(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn chama_oops_ku_sempri() {
    spia {
        mostran(oops_ku_sempri() sinon 42);
    } oops (err) {
        mostran(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn chama_spia_dentu_spia() {
    spia {
        mostran(spia_dentu_spia() sinon 42);
    } oops (err) {
        mostran(f"chamador apanhou {err.tipu} (linha {err.linha})");
    }
}

fn inisiu() {
    chama_so_sempri();
    chama_oops_ku_sempri();
    chama_spia_dentu_spia();
    mostran(lansa_ku_sempri() sinon 42);
}
