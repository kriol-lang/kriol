fn metadi(int a, int b) num : Erru {
    si b == 0 {
        lansa Erru{mensagem = "divizon pa zero"};
    }
    divolvi (num) a / b;
}

fn valida(int n) : Erru {
    si n < 0 {
        lansa Erru{mensagem = f"negativu: {n}"};
    }
}

fn kaminhu(int n) num : Erru {
    spia valida(n);
    num m = spia metadi(n, 4);
    divolvi m + 1;
}

fn inisiu() : Erru {
    konfirma(spia metadi(7, 2) == 3.5);
    spia {
        mostraln(metadi(7, 0));
    } oops (err) {
        mostraln(err.mensagem);
    }
    konfirma(spia kaminhu(10) == 3.5);
    spia {
        mostraln(kaminhu(-5));
    } oops (err) {
        mostraln(err.mensagem);
    }

    // The error is an ordinary molda value.
    Erru e = Erru{mensagem = "x"};
    mostraln(e.mensagem);

    // A fallible inisiu may finish without failing.
    spia valida(1);
}
