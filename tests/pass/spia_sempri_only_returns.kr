fn so_sempri() int {
    spia {
        divolvi 1;
    } sempri {
        mostraln("sempri");
    }
}

fn falivel(int b) int : Erru {
    spia {
        si b == 0 {
            lansa Erru{mensagem = "b é zero"};
        }
        divolvi 10 / b;
    } sempri {
        mostraln(f"sempri de {b}");
    }
}

fn inisiu() {
    mostraln(so_sempri());
    mostraln(falivel(2) sinau 0);
    mostraln(falivel(0) sinau 7);
}
