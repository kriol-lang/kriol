fn so_sempri() int {
    spia {
        divolvi 1;
    } sempri {
        mostran("sempri");
    }
}

fn falivel(int b) int : Erru {
    spia {
        si b == 0 {
            lansa Erru{mensage = "b é zero"};
        }
        divolvi 10 / b;
    } sempri {
        mostran(f"sempri de {b}");
    }
}

fn inisiu() {
    mostran(so_sempri());
    mostran(falivel(2) sinon 0);
    mostran(falivel(0) sinon 7);
}
