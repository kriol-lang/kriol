fn divide(int a, int b) int : Erru {
    si b == 0 {
        lansa Erru{mensagem = "b é zero"};
    }
    divolvi a / b;
}

fn passa(int a, int b) int : Erru {
    divolvi spia divide(a, b);
}

fn chamador(int b) {
    spia {
        int q = divide(10, b);
        mostraln(f"quociente {q}");
        int r = passa(10, b);
        mostraln(f"outra vez {r}");
    } oops (err) {
        mostraln(f"oops: {err.mensagem}");
        mostraln(err.tipu);
        konfirma(err.linha == 3);
    }
}

fn chamador_falivel(int b) int : Erru {
    spia {
        int r = passa(10, b);
        divolvi r;
    } oops (err) {
        mostraln(f"oops falível: {err.mensagem}");
    }
    divolvi -1;
}

fn so_sempri(int b) int : Erru {
    spia {
        int r = divide(10, b);
        mostraln(f"só sempri {r}");
    } sempri {
        mostraln("sempri do só sempri");
    }
    divolvi 0;
}

fn inisiu() {
    chamador(2);
    chamador(0);
    spia {
        mostraln(chamador_falivel(5));
    } oops (err) {
        mostraln(99);
    }
    spia {
        mostraln(chamador_falivel(0));
    } oops (err) {
        mostraln(99);
    }
    spia {
        mostraln(so_sempri(0));
    } oops (err) {
        mostraln(43);
    }
}
