molda Pontu {
    nter x;
    textu nomi;
}

// Leaves non-zero values where the next call's locals will live.
fn suja_stack() {
    nter[64] lixu = [123456789; 64];
    konfirma(lixu[63] == 123456789);
}

fn le_dipoz() {
    dipoz nter n;
    dipoz num f;
    dipoz bool b;
    dipoz textu s;
    dipoz Pontu p;
    si nau {
        n = 5;
        f = 1.5;
        b = sin;
        s = "nunka";
        p = Pontu::{x: 1, nomi: "p"};
    }
    konfirma(n == 0);
    konfirma(f == 0.0);
    konfirma(!b);
    konfirma(p.x == 0);
    mostran(s);
    mostran(p.nomi);
}

fn inisiu() {
    suja_stack();
    le_dipoz();

    // The previous iteration leaves 7 in the same stack slot.
    pa nter i = 0; i < 3; i += 1 {
        dipoz nter novu;
        si i == 99 {
            novu = 1;
        }
        konfirma(novu == 0);
        novu = 7;
    }
}
