// The input has a single line, so the second read reaches the end of input.
fn le_duas() : Erru {
    textu a = tenta toma();
    textu b = tenta toma();
    mostraln(f"{a} {b}");
}

fn inisiu() {
    textu primeira = toma() sinon "vaziu";
    textu segunda = toma() sinon "fim";
    mostraln(f"{primeira}/{segunda}");
}
