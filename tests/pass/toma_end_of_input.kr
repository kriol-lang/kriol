// The input has a single line, so the second read reaches the end of input.
fn le_duas() : Erru {
    textu a = spia toma();
    textu b = spia toma();
    mostraln(f"{a} {b}");
}

// The line read, or the fallback once the input has ended.
fn le_ou(textu fallback) textu {
    spia {
        divolvi toma();
    } oops (err) {
        divolvi fallback;
    }
}

fn inisiu() {
    textu primeira = le_ou("vaziu");
    textu segunda = le_ou("fim");
    mostraln(f"{primeira}/{segunda}");
}
