fn parti(int a, int b) int {
    divolvi a / b;
}

fn erru_no_oops() {
    spia {
        spia {
            mostraln(parti(1, 0));
        } oops (err) {
            mostraln(f"interior: {err.tipu}");
            int[2] a = [1, 2];
            int i = 2;
            mostraln(a[i]);
            mostraln("nunca depois do índice");
        } sempri {
            mostraln("sempri interior");
        }
        mostraln("nunca depois do spia interior");
    } oops (err) {
        mostraln(f"exterior: {err.tipu} na linha {err.linha}");
    }
}

fn chamada_no_oops() {
    spia {
        spia {
            paniku("primeiro");
        } oops (err) {
            mostraln(f"interior: {err.mensagem}");
            mostraln(parti(2, 0));
        }
    } oops (err) {
        mostraln(f"exterior: {err.mensagem} na linha {err.linha}");
    }
}

fn lansa_no_oops_ku_sempri() {
    spia {
        spia {
            paniku("segundo");
        } oops (err) {
            lansa Erru{mensagem = "do oops"};
        } sempri {
            mostraln("sempri do lansa");
        }
    } oops (err) {
        mostraln(f"exterior: {err.mensagem}");
    }
}

fn oops_termina_normal() {
    spia {
        spia {
            paniku("terceiro");
        } oops (err) {
            mostraln(f"interior: {err.mensagem}");
        } sempri {
            mostraln("sempri normal");
        }
        mostraln(parti(4, 0));
    } oops (err) {
        mostraln(f"exterior depois do oops: {err.tipu}");
    }
}

fn inisiu() {
    erru_no_oops();
    chamada_no_oops();
    lansa_no_oops_ku_sempri();
    oops_termina_normal();
    spia {
        mostraln(parti(3, 0));
    } oops (err) {
        mostraln("o spia seguinte ainda apanha");
    }
}
