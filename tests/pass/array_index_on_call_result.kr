// An array field of a value that is not stored in a variable can be indexed.
molda Par {
    int[3] v;
}

fn novu() Par {
    divolvi Par{v = [1, 2, 3]};
}

fn talvez(bool ok) Par : Erru {
    si !ok {
        lansa Erru{mensagem = "no"};
    }
    divolvi novu();
}

fn inisiu() : Erru {
    konfirma(novu().v[1] == 2);
    konfirma((spia talvez(sin)).v[2] == 3);
}
