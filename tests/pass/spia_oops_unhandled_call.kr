fn falha() int : Erru {
    lansa Erru{mensagem = "falha"};
}

fn no_oops() int : Erru {
    spia {
        lansa Erru{mensagem = "primeiro"};
    } oops (err) {
        int x = falha();
        mostraln(f"nunca {x}");
    }
    divolvi 1;
}

fn inisiu() {
    spia {
        mostraln(no_oops());
    } oops (err) {
        mostraln(42);
    }
}
