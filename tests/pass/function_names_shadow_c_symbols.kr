fn exit(int code) int {
    divolvi code + 1;
}

fn main() int {
    divolvi 41;
}

fn free() {
}

fn malloc(int bytes) int {
    divolvi bytes;
}

fn puts(textu s) {
    mostran(f"puts: {s}");
}

fn inisiu() {
    konfirma(exit(1) == 2);
