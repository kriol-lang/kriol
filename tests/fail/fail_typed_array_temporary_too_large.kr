// expect: o valor temporário ocupa 1600000 bytes, mais do que o limite de 1048576 bytes; guarda-o numa variável declarada fora das funções
molda Grandi {
    int[100000] v;
}

Grandi[2] global = (Grandi[]) [Grandi{v = [0; 100000]}, Grandi{v = [0; 100000]}];

fn inisiu() {
    global = (Grandi[]) [Grandi{v = [1; 100000]}, Grandi{v = [2; 100000]}];
}
