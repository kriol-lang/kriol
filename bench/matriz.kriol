// Ciclos encadeados com reais: produto de duas matrizes 400 x 400.
num[400][400] a = [[0.0; 400]; 400];
num[400][400] b = [[0.0; 400]; 400];
num[400][400] c = [[0.0; 400]; 400];

fn inisiu() {
    int n = 400;
    pa int i = 0; i < n; i += 1 {
        pa int j = 0; j < n; j += 1 {
            a[i][j] = (num) (i + j) / n;
            b[i][j] = (num) (i + 2 * j) / n;
        }
    }
    pa int i = 0; i < n; i += 1 {
        pa int j = 0; j < n; j += 1 {
            num soma = 0.0;
            pa int k = 0; k < n; k += 1 {
                soma += a[i][k] * b[k][j];
            }
            c[i][j] = soma;
        }
    }
    num traco = 0.0;
    pa int i = 0; i < n; i += 1 {
        traco += c[i][i];
    }
    mostran((int) traco);
}
